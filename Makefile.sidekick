	  -s \
	  -L \
	  -o $(GLOBAL_TMP_DIR)/$(__snyk_artifact_sha) \
	  $(__snyk_base_url)/$(__snyk_artifact_sha)
	cd $(GLOBAL_TMP_DIR) && $(SHA256SUM) -c $(__snyk_artifact_sha)
	chmod a+x $(GLOBAL_TMP_DIR)/$(__snyk_artifact)
